JAP_API_KEY=your_key_here
JAP_API_URL=https://justanotherpanel.com/api/v2
JAP_SERVICE_ID=7394
# Optional — manual boost panel (+20…+100). Default 7381 (fast 1-post views).
JAP_MANUAL_BOOST_SERVICE_ID=7381
ORDER_QTY=21
LIVE_MODE=false
PORT=3847
CHANNEL_USERNAME=bansyndicate
CHANNEL_USERNAMES=bansyndicate,robogems
CHANNEL_URL=https://t.me/bansyndicate
AUTO_DISCOVER_POSTS=true
# Auto-detect tick gap (ms). Default 200; floor 100.
AUTO_DISCOVER_INTERVAL_MS=200
# Primary embed probe timeout (ms). Default 3500.
TELEGRAM_PROBE_TIMEOUT_MS=3500
# Bot as channel admin → real auto posts via api.telegram.org (needs network reachability)
TELEGRAM_BOT_TOKEN=
# Optional: only auto-track message ids AFTER this (e.g. 78 skips 77/78)
# DISCOVER_AFTER_MESSAGE_ID=78

# X / Twitter followers page → http://localhost:3847/twitter
JAP_TWITTER_FOLLOWERS_SERVICE_ID=9011
TWITTER_PROFILE_URL=https://x.com/wangchaionbnb

# X post views → http://localhost:3847/twitter-views
# Use Tweet Views (public view count). Do not use likes/retweet IDs.
JAP_TWITTER_VIEWS_SERVICE_ID=8413
# TWITTER_VIEWS_POST_URL=https://x.com/wangchaionbnb/status/1234567890

# X post likes & comments → http://localhost:3847/twitter-posts
# Paste /status/ URLs — not profile links
JAP_TWITTER_LIKES_SERVICE_ID=8847
JAP_TWITTER_COMMENTS_SERVICE_ID=341
# Custom comments: paste your own lines on /twitter-posts (default). Random is optional.
TWITTER_POST_DEFAULT_TASK=likes
# TWITTER_POST_URL=https://x.com/Bancrypto__/status/1234567890

# Instagram followers page → http://localhost:3847/instagram
# Drip-friendly service (min ≤ 5) required for organic +5 batches
JAP_INSTAGRAM_FOLLOWERS_SERVICE_ID=352
INSTAGRAM_PROFILE_URL=https://www.instagram.com/Bancrypto__/

# Instagram post likes page → http://localhost:3847/instagram-likes
# Paste /p/ or /reel/ URLs — not profile links
JAP_INSTAGRAM_LIKES_SERVICE_ID=8216
# INSTAGRAM_LIKES_POST_URL=https://www.instagram.com/p/ABC123/

# FOMO (fomo.family) followers → http://localhost:3847/fomo
# Locked solid account: @noormemewebdev
# House services: 900001 Starter · 900002 Heat (default) · 900003 Legend
JAP_FOMO_FOLLOWERS_SERVICE_ID=900002
FOMO_PROFILE_URL=https://fomo.family/r/noormemewebdev
FOMO_EST_RATE_PER_1K=1.50

# YouTube desk → http://localhost:3847/youtube
# Optional per-task JAP service IDs (otherwise cheapest matching catalog service is used)
JAP_YOUTUBE_VIEWS_SERVICE_ID=3072
JAP_YOUTUBE_LIKES_SERVICE_ID=3073
JAP_YOUTUBE_SUBS_SERVICE_ID=3074
JAP_YOUTUBE_COMMENTS_SERVICE_ID=3075
JAP_YOUTUBE_SHARES_SERVICE_ID=3076
YOUTUBE_DEFAULT_TASK=subscribers
YOUTUBE_DEFAULT_URL=https://www.youtube.com/@ognoormuhammad8951

# Phone queue → http://localhost:3847/m
# Same project the phone page writes to. Desktop polls pending rows and starts views.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Separate extra-fast sniffer web (npm run sniffer) — http://127.0.0.1:3850
SNIFFER_PORT=3850
SNIFFER_FORWARD_URL=http://127.0.0.1:3847/api/posts
SNIFFER_HOT_MS=0
SNIFFER_CRUISE_MS=5
SNIFFER_HOT_WINDOW_MS=300000
SNIFFER_AHEAD=1
SNIFFER_CONCURRENCY=4
SNIFFER_TRY_DIRECT=false
